---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: voting-app-deployment
  labels:
    name: voting-app
    author: chaitanya
spec:
  replicas: 2
  selector:
    matchLabels:
      name: voting-app
  template:
    metadata:
      name: voting-app
      labels:
        name: voting-app
  spec:
    containers:
      - name: voting-app
        image: dockersample/examplevotingapp_vote

